# ─────────────────────────────────────────────
# GHL (GoHighLevel) — já configurada
# ─────────────────────────────────────────────
GHL_API_KEY=seu_ghl_api_key_aqui

# ─────────────────────────────────────────────
# RESEND — envio de email
# Crie em: https://resend.com/api-keys
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxx   # ← adicione sua chave real APENAS no painel da Vercel, nunca aqui

# Email remetente (domínio verificado no Resend)
RESEND_FROM_EMAIL=noreply@neuralops.com.br

# ─────────────────────────────────────────────
# GHL BOOKING — link de agendamento
# ─────────────────────────────────────────────
GHL_BOOKING_URL=https://neuralops.com.br/agendar

# ─────────────────────────────────────────────
# DIAGNÓSTICOS (api/diagnostico-lead.js)
# Pelo menos um destino: GHL_API_KEY ou LEAD_WEBHOOK_URL
# ─────────────────────────────────────────────
GHL_LOCATION_ID=o9LtB6haFl99RD67rloF
LEAD_WEBHOOK_URL=            # opcional: cópia do lead em JSON (ex.: webhook do n8n)
LEAD_WEBHOOK_SECRET=         # opcional: enviado no header X-Webhook-Secret
SITE_URL=https://neuralops.com.br
BOOKING_URL=https://neuralops.com.br/agendar/
